# Copy to .env (cp .env.example .env). Real environment variables win over this file.

# Docker Compose (PostgreSQL + PostGIS). Defaults match docker-compose.yml.
# POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB only apply on first init of the volume.
POSTGRES_USER=transitops
POSTGRES_PASSWORD=transitops
POSTGRES_DB=transitops
POSTGRES_PORT=5432

# API
PORT=3001
# Not used by the API yet.
DATABASE_URL=postgres://transitops:transitops@localhost:5432/transitops
# Secret, backend only. Not used yet. Leave empty for now.
MBTA_API_KEY=
